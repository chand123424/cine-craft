# Keep these values server-side only.
GROK_API_KEY=
GOOGLE_AI_API_KEY=
HUGGINGFACE_API_KEY=

# mock is deterministic and needs no key. Use gemini, grok, or huggingface in production.
AI_PROVIDER=mock
AI_MODEL=
REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE=en-US-Neural2-F
OTHER_MEDIA_API_KEYS=
MEDIA_ROOT=media
